{
    "name": "alex-kassel/workspace-development-toolkit",
    "description": "Multi-workspace local package development toolkit for Laravel: manage, symlink, and develop isolated packages with ease.",
    "license": "MIT",
    "type": "library",
    "version": "0.1.0",
    "keywords": [
        "laravel",
        "workspace",
        "packages",
        "composer",
        "monorepo",
        "toolkit"
    ],
    "authors": [
        {
            "name": "Alex Kassel",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "AlexKassel\\WorkspaceDevelopmentToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexKassel\\WorkspaceDevelopmentToolkit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlexKassel\\WorkspaceDevelopmentToolkit\\WorkspaceDevelopmentToolkitServiceProvider"
            ],
            "aliases": {
                "Workspace": "AlexKassel\\WorkspaceDevelopmentToolkit\\Facades\\Workspace"
            }
        }
    }
}
